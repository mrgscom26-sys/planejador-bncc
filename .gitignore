# Ambientes e Segredos (Environment & Secrets)
# ==============================================================================
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# ==============================================================================
# Dependências e Builds - Node.js / JavaScript / TypeScript
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diretórios de build e distribuição
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/

# ==============================================================================
# Dependências e Builds - Python (caso aplicável)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
